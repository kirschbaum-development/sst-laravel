  {
    "type": "aws:kms/key:Key",
    "name": "Vault-EnvKey",
    "inputs": {
      "deletionWindowInDays": 7,
      "description": "Encrypts the environment of the Vault Laravel services (sst-laravel).",
      "enableKeyRotation": true
    }
  },
  {
    "type": "aws:kms/keyPolicy:KeyPolicy",
    "name": "Vault-EnvKeyPolicy",
    "inputs": {
      "keyId": "Vault-EnvKey-id",
      "policy": {
        "Statement": [
          {
            "Effect": "Allow",
            "NotAction": [
              "kms:Decrypt",
              "kms:ReEncryptFrom"
            ],
            "Principal": {
              "AWS": "arn:aws:iam::123456789012:root"
            },
            "Resource": "*",
            "Sid": "AccountManagesTheKeyButCannotDecrypt"
          },
          {
            "Action": "kms:Decrypt",
            "Condition": {
              "ArnEquals": {
                "aws:PrincipalArn": [
                  "arn:aws:mock:us-east-1:123456789012:Vault-WebExecutionRole"
                ]
              },
              "StringEquals": {
                "kms:CallerAccount": "123456789012",
                "kms:ViaService": [
                  "s3.us-east-1.amazonaws.com",
                  "secretsmanager.us-east-1.amazonaws.com"
                ]
              }
            },
            "Effect": "Allow",
            "Principal": {
              "AWS": "*"
            },
            "Resource": "*",
            "Sid": "ServicesDecryptTheirEnvironment"
          }
        ],
        "Version": "2012-10-17"
      }
    }
  },
