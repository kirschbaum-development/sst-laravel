          },
          {
            "Action": "secretsmanager:GetSecretValue",
            "Effect": "Allow",
            "Resource": "arn:aws:secretsmanager:us-east-1:123456789012:secret:/app/dev/sst-laravel/Vault/multiline-env-??????",
            "Sid": "ReadMultilineValues"
          }
        ],
        "Version": "2012-10-17"
      }
    }
