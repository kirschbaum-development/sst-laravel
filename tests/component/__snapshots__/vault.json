  {
    "type": "aws:iam/policy:Policy",
    "name": "Vault-EnvRead",
    "parent": "Vault",
    "inputs": {
      "description": "Reads the environment of the Vault Laravel services (sst-laravel).",
      "policy": {
        "Statement": [
