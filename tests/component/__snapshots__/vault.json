              }
            },
            "Effect": "Deny",
            "Principal": "*",
            "Resource": [
              "arn:aws:mock:us-east-1:123456789012:Vault-EnvFiles",
              "arn:aws:mock:us-east-1:123456789012:Vault-EnvFiles/*"
            ],
            "Sid": "DenyInsecureTransport"
          }
