      },
      "taskDefinition": "arn:aws:mock:us-east-1:123456789012:Mini-WebTask",
      "waitForSteadyState": false
    }
  },
  {
    "type": "aws:ecs/taskDefinition:TaskDefinition",
    "name": "Mini-WebTask",
