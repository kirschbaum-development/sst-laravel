                "awslogs-stream-prefix": "/service"
              }
            },
            "name": "Mini-Web",
            "portMappings": [
              {
                "containerPortRange": "1-65535"
              }
            ],
            "pseudoTerminal": true,
            "secrets": []
          }
        ]
      },
      "cpu": "256",
      "executionRoleArn": "arn:aws:mock:us-east-1:123456789012:Mini-WebExecutionRole",
