    const { LaravelService } = await import("@kirschbaum-development/sst-laravel");

    /**
     * A VPC is required — containers (Fargate) can only run inside one.
     * This default has no NAT gateway, so it stays cheap (about $0.50/month
     * for service discovery). Without NAT, containers run in the public
     * subnets with a public IP (~$3.65/month each); inbound traffic still
     * only comes through the load balancer.
     *
     * Add `nat: "ec2"` (~$13/month for the default 2 zones) to keep
     * containers in private subnets, for example when a third party needs a
     * fixed outbound IP. Avoid `nat: "managed"` (~$73/month) unless you need
     * the scale.
     *
     * To reuse an existing VPC instead of creating one:
     * const vpc = sst.aws.Vpc.get("MyVpc", "vpc-12345678901234567");
     */
    const vpc = new sst.aws.Vpc("MyVpc");

    const app = new LaravelService("MyLaravelApp", {
      vpc,

      config: {
        php: 8.4,
        environment: {
          // First deploy: copy `.env.example` to `.env.<stage>`
          // (e.g. `.env.dev`), set a key, and deploy. Simple, nothing extra.
          file: `.env.${$app.stage}`,

          // Teams / CI alternative: store the file in AWS Secrets Manager.
          // const { RemoteEnvVault } = await import("@kirschbaum-development/sst-laravel");
          // const env = new RemoteEnvVault("Env");
          // secrets: env,
        },
        // deployment: {
        //   // Runs at container startup. Only enable after a persistent
        //   // database exists — otherwise migrations have nowhere to run.
        //   script: 'infra/deploy.sh',
        // },
      },

      web: {
        // Simple container size: small (0.5 vCPU / 1 GB), medium
        // (1 vCPU / 2 GB), large (2 vCPU / 4 GB). `cpu`/`memory` win over it.
        size: "small",
        healthCheck: { path: "/up" },

        // Add a custom domain when DNS is ready. Without it you get the load
        // balancer address for testing (http only).
        // domain: {
        //   // Same-account Route53 is automatic. For Cloudflare use
        //   // `dns: sst.cloudflare.dns()`. For manual DNS use `dns: false`.
        //   name: $app.stage === "production"
        //     ? "example.com"
        //     : `${$app.stage}.example.com`,
        // }
      },

      // Add these only when the app needs them:
      //
      // Database (Postgres). It sits in the VPC's private subnets, and the
      // containers reach it with or without NAT.
      // const database = new sst.aws.Postgres('MyDB', { vpc });
      // link: [database],
      //
      // Background work (queues, scheduler) in a separate container:
      // workers: [
      //   {
      //     horizon: true,
      //     scheduler: true,
      //   }
      // ],
      //
      // WebSockets:
      // reverb: {
      //   domain: {
      //     name: $app.stage === "production"
      //       ? "ws.example.com"
      //       : `ws.${$app.stage}.example.com`,
      //   },
      // },
    });

    return {
      url: app.url,
      deployment: app.deployment,
    };
